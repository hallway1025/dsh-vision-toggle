{
  "name": "dsh-vision-toggle",
  "version": "0.6.2",
  "description": "Let DSH watch a live screen or camera feed: score every frame by how much the picture changed, keep only the ones that matter, and pack them into one image. · 让 AI 实时看见你的屏幕，只传「画面变了」的那几帧。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "screen-capture",
    "vision",
    "llm",
    "ffmpeg",
    "realtime",
    "token-efficient",
    "multimodal"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pack": "./src/pack.js",
    "./png": "./src/png.js",
    "./pipeline": "./src/pipeline.js",
    "./capture": "./src/capture.js",
    "./runner": "./src/runner.js",
    "./loop": "./src/loop.js",
    "./timer": "./src/timer.js",
    "./tool-spec": "./src/tool-spec.js",
    "./client": "./src/client.js",
    "./buffer": "./src/buffer.js",
    "./sentinel": "./src/sentinel.js",
    "./auto-mode": "./src/autoMode.js",
    "./config": "./src/config.js",
    "./privacy": "./src/privacy.js",
    "./model-info": "./src/model-info.js",
    "./dialog": "./src/dialog.js"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "debug:live": "node debug/live.mjs",
    "install-dev": "node scripts/install-dev.mjs",
    "check": "node scripts/install-dev.mjs --check",
    "sync:window": "node scripts/sync-window.mjs",
    "check:window": "node scripts/sync-window.mjs --check",
    "prepack": "node scripts/sync-window.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "Apache-2.0"
}
